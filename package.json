{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "A terminal built around running many Claude and Codex sessions across repos",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r run build",
    "build:daemon": "pnpm --filter @jarvis/daemon build",
    "build:cli": "pnpm --filter @jarvis/cli build",
    "dev": "pnpm build:daemon && pnpm --filter @jarvis/desktop dev",
    "start": "pnpm build && pnpm --filter @jarvis/desktop start",
    "package": "pnpm build && pnpm --filter @jarvis/desktop package",
    "install:local": "sh scripts/install-local.sh",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "e2e": "pnpm build && node e2e/relaunch.e2e.mjs",
    "e2e:rich": "pnpm build && node e2e/rich.e2e.mjs && node e2e/rich-commands.e2e.mjs && node e2e/rich-extras.e2e.mjs && node e2e/rich-agents.e2e.mjs",
    "e2e:ui": "pnpm build && node e2e/layout.e2e.mjs && node e2e/themes.e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
